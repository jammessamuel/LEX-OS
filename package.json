{
  "name": "lex-os",
  "version": "0.0.0",
  "private": true,
  "description": "Intelligent legal operations system for Brazilian law firms.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:config": "docker compose config --quiet",
    "infra:dependencies": "node infra/scripts/start-dependencies.mjs",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps",
    "infra:up": "docker compose up --detach --build --wait",
    "lint": "turbo run lint",
    "prepare": "node infra/scripts/setup-git-hooks.mjs",
    "test": "turbo run test",
    "test:e2e": "corepack pnpm --filter @lex-os/web test:e2e",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "db:format": "corepack pnpm --filter @lex-os/database db:format",
    "db:generate": "corepack pnpm --filter @lex-os/database db:generate",
    "db:migrate:deploy": "corepack pnpm --filter @lex-os/database db:migrate:deploy",
    "db:migrate:dev": "corepack pnpm --filter @lex-os/database db:migrate:dev",
    "db:migrate:status": "corepack pnpm --filter @lex-os/database db:migrate:status",
    "db:reset": "corepack pnpm --filter @lex-os/database db:reset",
    "db:seed": "corepack pnpm --filter @lex-os/database db:seed",
    "db:validate": "corepack pnpm --filter @lex-os/database db:validate"
  },
  "devDependencies": {
    "@lex-os/eslint-config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.5",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  }
}
