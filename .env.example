NODE_ENV=development
CASE_ARCHIVE=fictional
# Managed platforms may inject PORT; when present it overrides this local API port.
API_PORT=3000
DEPENDENCY_TIMEOUT_MS=2000
LOG_LEVEL=info
WORKER_READY_FILE=/tmp/lex-os-worker-ready
WEB_ORIGIN=http://localhost:5173

AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_LOGIN_ATTEMPT_LIMIT=5
AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=900

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-local-password
DATABASE_SSL=false
POSTGRES_DOCKER_PORT=5433
DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:5433/postgres?schema=public
SEED_ADMIN_PASSWORD=replace-with-local-admin-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_DOCKER_PORT=6379

PROCESSING_QUEUE_PREFIX=lex-os
PROCESSING_JOB_ATTEMPTS=3
PROCESSING_JOB_BACKOFF_MS=250
PROCESSING_WORKER_CONCURRENCY=2
PROCESSING_STALE_AFTER_SECONDS=60
PROCESSING_RECONCILE_INTERVAL_SECONDS=30

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=lex-os-private
OBJECT_STORAGE_ACCESS_KEY=replace-with-local-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-local-secret-key
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=60
OBJECT_STORAGE_QUARANTINE_STALE_AFTER_SECONDS=3600
FILE_INTAKE_MAX_FILE_BYTES=26214400
FILE_INTAKE_MAX_FILES_PER_REQUEST=10
FILE_INTAKE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_SMTP_PORT=1025
# Saida de e-mail. Em desenvolvimento aponta para o Mailpit do Compose.
# Chave de 32 bytes em base64 que cifra o segredo do segundo fator em repouso.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECOND_FACTOR_ENCRYPTION_KEY=cmVwbGFjZS13aXRoLWEtbG9jYWwtMzItYnl0ZS1rZXk=

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=nao-responda@lexos.invalid
MAILPIT_WEB_PORT=8025
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
