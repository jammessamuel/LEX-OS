    "bullmq": "5.81.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@lex-os/eslint-config": "workspace:*",
    "@lex-os/tsconfig": "workspace:*",
    "jest": "30.4.2"
