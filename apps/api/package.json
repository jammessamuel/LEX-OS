{
  "name": "@lex-os/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "node --test test/unit/*.test.cjs",
    "test:integration": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../infra/scripts/github-test-annotations.mjs --test-reporter-destination=stderr test/integration/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@aws-sdk/lib-storage": "3.1103.0",
    "@aws-sdk/s3-request-presigner": "3.1103.0",
    "@lex-os/ai-prompts": "workspace:*",
    "@lex-os/config": "workspace:*",
    "@lex-os/contracts": "workspace:*",
    "@lex-os/database": "workspace:*",
    "@lex-os/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "argon2": "0.45.1",
    "bullmq": "5.81.0",
    "busboy": "1.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "file-type": "21.3.4",
    "helmet": "8.3.0",
    "pg": "8.22.0",
    "redis": "6.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@lex-os/eslint-config": "workspace:*",
    "@lex-os/tsconfig": "workspace:*",
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.20.4",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
